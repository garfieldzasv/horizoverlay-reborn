node_modules/

# Reference copies of the upstream build, kept locally to compare against.
# They are someone else's compiled output, they are not needed to build or run
# this, and site/ carries sourcemaps -- nothing here belongs in the repo.
site/
preview/

# build/ is deliberately NOT ignored: the overlay is used by pointing ACT at
# build/index.html, so the artefact has to be here for anyone who just wants to
# run it rather than build it.
